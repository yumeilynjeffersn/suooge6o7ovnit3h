# ==============================================================================

cd "$SCRIPT_DIR" # 👈 SEEK

[[ -d .git    ]] || abort 'The directory `.git` not found.'
[[ -f version ]] || abort 'The file `version` not found.'

CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null)"; readonly CURRENT_BRANCH # Get current branch
CURRENT_BRANCH_HEAD="$(git rev-parse HEAD)"; readonly CURRENT_BRANCH_HEAD
