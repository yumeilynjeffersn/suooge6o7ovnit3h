set -eu || { set -o errexit && set -o nounset; }; set -o pipefail; set +o monitor; set +o histexpand; set +o history # Use `set -o` to list all shell settings # https://www.gnu.org/software/bash/manual/html_node/

source .set
SCRIPT_DIR=$(dirname "$(realpath "$0")"); readonly SCRIPT_DIR
error_code=1 # Praesumptio
ending='Done.'

for x in http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY; do # [[ -v http_proxy ]] && unset http_proxy; [[ -v https_proxy ]] && unset https_proxy; [[ -v all_proxy ]] && unset all_proxy; [[ -v HTTP_PROXY ]] && unset HTTP_PROXY; [[ -v HTTPS_PROXY ]] && unset HTTPS_PROXY; [[ -v ALL_PROXY ]] && unset ALL_PROXY; [[ ! -v http_proxy && ! -v https_proxy && ! -v all_proxy && ! -v HTTP_PROXY && ! -v HTTPS_PROXY && ! -v ALL_PROXY ]] && echo 'Environment variables for proxying have been reset!'
  [[ -v "$x" ]] && unset "$x"
done && echo 'Environment variables for proxying have been reset!'

# ==============================================================================
# 🛠 F U N C T I O N S
# ==============================================================================

div() { local x="${1:-=}"; local y="${2:-80}"; echo "$(printf "%${y}s" "" | tr ' ' "${x}")"; }; readonly -f div

abort() {
  ending="${1:-$ending}"
  exit ${2:-1} # Default error code is 1 (common)
}; readonly -f abort

cadence() { # 🔗 CALLBACK
  error_code=$? # Return Code
  set +eu || { set +o errexit && set +o nounset; }; set +o pipefail; set -o monitor; set -o histexpand; set -o history # Use `set -o` to list all shell settings # https://www.gnu.org/software/bash/manual/html_node/The-Set-Builtin.html
  # ls -la "$TMP_WT_DIR"
  cd "$SCRIPT_DIR" # 👈 SEEK
  [[ -n "${wtadded+x}"    && -n "$wtadded"    && "$wtadded" = true ]] && git worktree remove "$TMP_WT_DIR" --force && echo '🗑  Temporary worktree removed.'
  [[ -n "${TMP_WT_DIR+x}" && -n "$TMP_WT_DIR" && -d "$TMP_WT_DIR"  ]] && rm -rf "$TMP_WT_DIR" # 🔪 God protects those who are careful... 🐗
  # [[ $error_code -ne 0 ]] && cat assets/ascii-arts/fuuuu.txt
  [[ $error_code -ne 0 && "$ending" = Done. ]] && ending='An error occurred during execution!'
  # [[ $error_code -ne 0 ]] && rollback()
  [[ -v ending && -n "$ending" ]] && echo "$0: $ending"
}; readonly -f cadence; trap cadence EXIT # Set the signal handler `EXIT` (to ensure a graceful cadence)

ask_for_continue() {
  local q="${1:-Continue?}"
  [[ "$AUTOCONFIRMATION" = true ]] || {
    while true; do # As Soon As Possible
      read -r -p "$q (y/n): " answer || : # 📞 WAZZA
      case "$answer" in
        [Yy]) break ;;  # Ajo!
        [Nn]) exit 0 ;; # 🔳 Q.E.D.
        *) echo 'なにこれ!?' ;; # 🐬
      esac
    done
  }
}; readonly -f ask_for_continue

ask_for_confirmation() {
  local q="${1:-Do ya confirm?}"
  [[ "$AUTOCONFIRMATION" = true ]] || {
    while true; do # Ad aeternum
      read -r -p "$q (y/n): " answer || : # 🍕 WAZZA
      case "$answer" in # If the shoe fits, wear it
        [Yy]) return 0 ;; # Возвращает 0 (успех) для продолжения
        [Nn]) return 1 ;; # Возвращает 1 (ошибка) для выхода
        *) echo 'なにこれ!?' ;; # 🐬
      esac
    done
  }; return 0 # Если AUTOCONFIRMATION=true, автоматически возвращает 0
}; readonly -f ask_for_confirmation

