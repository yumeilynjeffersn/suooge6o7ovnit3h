# ==============================================================================

[[ "$(uname)" = 'Linux' ]] || { echo 'The script needs to be run on Linux. 🐧' && exit 1; }

[[ "${BASH_VERSINFO[0]}" -ge 4 ]] || { echo 'To run the script, you must use Bash version >= 4.0 (or later).' && exit 1; }

# ==============================================================================
