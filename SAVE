# mapfile -d '' CURRENT_STAGED_CHANGES < <(git diff --cached --name-only -z) # Проиндексированные (staged) файлы текущей ветки
IFS='.' read -r -a array <<< "$(cat version)" # https://itisgood.ru/2024/03/13/chto-takoe-ifs-v-skriptakh-na-bash/
mutatus=false # Assume no changes (praesumptio)
stashed=false # Assume no stashed (praesumptio)
wtadded=false # Assume no worktree added (praesumptio)
target_branch_exists=false # Target branch ∃(x)ISTENce (praesumptio)
online=false # Let’s assume that the remote repository isn’t added or is unavailable (praesumptio)

# ==============================================================================
# 🐬 P R E F E R E N C E S
# ==============================================================================

TMP_WT_DIR="$(mktemp -d)" || TMP_WT_DIR="/tmp/fallback-$$"; readonly TMP_WT_DIR # Temporary worktree directory
TARGET_BRANCH="${1:-develop}"; readonly TARGET_BRANCH

# ==============================================================================
# 💾 S A V E
# ==============================================================================

div && echo "Current branch 👉 \`${CURRENT_BRANCH}\`" && div && git status && div && echo '🎋 Branches available' && div - && git branch -vva

div && if git remote | grep -q origin; then # Проверяем, существует ли удалённый репозиторий origin
  echo 'The `origin` remote repository is specified.'
  if git ls-remote --exit-code origin &>/dev/null; then # Проверяем, доступен ли origin (например, можно сделать ping)
    online=true && echo 'The `origin` remote repository is available.'
  else echo "⚠️  WARNING: The \`origin\` remote repository is unavailable. Continuing execution of the script will only result in local operations. 🤷‍" && ask_for_continue 'Are you sure you wanna continue?'; fi
else echo "⚠️  WARNING: The \`origin\` remote repository isn’t specified. Continuing execution of the script will only result in local operations. 🤷‍" && ask_for_continue 'Are you sure you wanna continue?'; fi

[[ "$FORCE" = true ]] \
  && div && echo "⚠️  WARNING: Forced mode is enabled. Continuing execution of the script will overwrite the existing specified branch. 🤷‍" && ask_for_continue 'Are you sure you wanna continue?'

git diff-index --quiet HEAD -- && git diff-index --cached --quiet HEAD -- || { # There are some changes in the current branch... 🐿

  mutatus=true # A posteriori

  [[ "$DUMMY" = true ]] || git diff-index --quiet HEAD -- || { # Есть непроиндексированные (unstaged) файлы в текущей ветке
    div && echo "⚠️  WARNING: There are unstaged files in the current branch."
    ask_for_confirmation 'Do you want to add them to the stage?' && {
      git add -A || git add . # Добавить в индекс ВСЕ измененённые файлы во всём репозитории (всей директории)
    } || { # 💾 BACKUP of unstaged changes (ad arbitrium)
      git stash push -u -m "Temporary stash before switching to \`${TARGET_BRANCH}\`"
      stash_reference="$(git rev-parse --verify stash@{0})"
      stashed=true
    }
  }

  [[ "$DUMMY" = true ]] || git diff-index --cached --quiet HEAD -- || git commit -m "WIP: temporary commit for cherry-pick" # 📌 Immutable Object

}

current_commit_hash="$(git rev-parse HEAD)" && [[ "$DEBUG" = true ]] && echo "Current commit hash: $current_commit_hash"

# ------------------------------------------------------------------------------

[[ "$online" == true ]] && {
  git fetch --prune || git remote prune origin # Обновить локальные ссылки на удалённые ветки (`origin/*`)
  if git ls-remote --exit-code --heads origin "$TARGET_BRANCH" &>/dev/null; then # Гарантированно получаем указанную ветку локально, если она существует удалённо
    div && echo "Remote branch \`${TARGET_BRANCH}\` already exists. Fetch..." && div -
    git fetch origin "$TARGET_BRANCH" && div - && echo '=> OK' || abort 'Error: Failed to fetch!' # 📥 FETCH
    [[ "$FORCE" = true ]] && {
      div - && echo "☝️  #FORCE_MODE: Remove remote branch \`origin/${TARGET_BRANCH}\`"
      git push origin --delete "$TARGET_BRANCH" && div - && echo '=> OK' || abort "Error: Failed to remove remote branch \`origin/${TARGET_BRANCH}\`" # ⚠️ ⚠️ ⚠️
    } || {
      if git show-ref --verify --quiet "refs/heads/${TARGET_BRANCH}"; then echo 12345
        git pull origin "$TARGET_BRANCH":"$TARGET_BRANCH"
      else
        div - && echo 'Create a local branch that tracks the remote branch w/o switching the current one...'
        git branch "$TARGET_BRANCH" "origin/${TARGET_BRANCH}" && div - && echo '=> OK'
      fi
    }
  fi  
}

# ------------------------------------------------------------------------------

# ❌ Удалить существующую ветку, если установлен принудительный режим 🔪
#
[[ "$DUMMY" = true ]] || {
  [[ "$FORCE" = true ]] && {
    git show-ref --verify --quiet "refs/heads/${TARGET_BRANCH}" && \
      git checkout --detach && \
      git branch -D "$TARGET_BRANCH" # Preventatively 🐗
  }
}

# ------------------------------------------------------------------------------

[[ "$DEBUG" = true ]] && {
  div '>'
  git show-ref --verify "refs/heads/${TARGET_BRANCH}" && echo "Branch $TARGET_BRANCH exists locally" || echo "Branch $TARGET_BRANCH does not exist locally"
  div -
  git branch -vva
  div '<'
}

# ------------------------------------------------------------------------------

[[ "$DEBUG" = true ]] && {

  div && echo '📝 Case Analysis' && div -

  if git show-ref --verify --quiet "refs/heads/${TARGET_BRANCH}"; then # Check the existence of a branch (locally) # Альтернативно: `if git rev-parse --verify "$TARGET_BRANCH" &>/dev/null; then` — Проверяет, существует ли любой Git-объект, который можно разрешить как `$TARGET_BRANCH`. Это может быть: локальная ветка, remote-tracking ветка (`origin/$TARGET_BRANCH`), тег, commit hash.

    # Case "A"

    echo "👉 Branch ${TARGET_BRANCH} exists (locally)."

    target_branch_exists=true # A posteriori

    if [[ "$CURRENT_BRANCH" = "$TARGET_BRANCH" ]]; then # Check if the specified branch is current 🐇
      echo "👉 The specified branch \`${TARGET_BRANCH}\` is current."
      if ! git diff-index --cached --quiet HEAD --; then # Check if there are changes on the current branch
        echo "👉 There are changes on the current branch (\`${CURRENT_BRANCH}\`)."
        [[ "$DUMMY" = true ]] || { # Actions for the case: the specified branch exists, is current, and has changes
          :
        }
      else
        echo "👉 No changes on the current branch (\`${CURRENT_BRANCH}\`)."
        [[ "$DUMMY" = true ]] || { # Actions for the case: the specified branch exists, is current, and has no changes
          :
        }
      fi
    else
      echo "👉 The current branch is \`${CURRENT_BRANCH}\` (different from the specified one)."
      # echo "⚠️  WARNING: Continuing execution of the script will overwrite the existing specified branch. 🤷‍" && ask_for_continue
      if ! git diff-index --cached --quiet HEAD --; then # Check if there are changes on the current branch
        echo "👉 There are changes on the current branch (\`${CURRENT_BRANCH}\`)."
        [[ "$DUMMY" = true ]] || { # Actions for the case: the specified branch exists, is different from the current branch, and has changes
          :
        }
      else
        echo "👉 No changes on the current branch (\`${CURRENT_BRANCH}\`)."
        [[ "$DUMMY" = true ]] || { # Actions for the case: the specified branch exists, is different from the current branch, and has no changes
          :
        }
      fi
    fi
    [[ "$DUMMY" = true ]] || { # Create temporary branch
      # 👇 BRANCH 
      #
      # git switch -C "tmp-${TARGET_BRANCH}" || git checkout -B "tmp-${TARGET_BRANCH}" || abort "An error occurred while switching to or creating the \`tmp-${TARGET_BRANCH}\` branch." # 👈 BRANCH
      :
    }
  else

    # Case "B"

    echo "👉 The branch \`${TARGET_BRANCH}\` doesn’t exist."

    if ! git diff-index --cached --quiet HEAD --; then # Check if there are changes on the current branch
      echo "👉 There are changes on the current branch (\`${CURRENT_BRANCH}\`)."
      [[ "$DUMMY" = true ]] || { # Actions for the case: the specified branch doesn’t exist, there are changes
        :
      }
    else
      echo "👉 No changes on the current branch (\`${CURRENT_BRANCH}\`)."
      [[ "$DUMMY" = true ]] || { # Actions for the case: the specified branch doesn’t exist, there are no changes
        # git branch -M "$TARGET_BRANCH" # Принудительно переименовать текущую ветку указанным именем
        :
      }
    fi
    [[ "$DUMMY" = true ]] || { # Create target branch (directly)
      # 👇 BRANCH 
      #
      # git switch -C "$TARGET_BRANCH" || git checkout -B "$TARGET_BRANCH" || abort "An error occurred while switching to or creating the \`${TARGET_BRANCH}\` branch." # 👈 BRANCH # Создать ветку из текущей и переключиться на неё # ⚠️ Верхний регистр параметров `-C` и `-B` означает принудительный характер: ветка будет ПЕРЕЗАПИСАНА, если указанное имя занято! # ☝️ Все незакоммиченные изменения (staged и unstaged) из текущей ветки автоматически “переедут” в новую ветку
      :
    }
  fi
}

# ------------------------------------------------------------------------------

[[ "$DUMMY" = true ]] || {

  div && echo '🌳 Add the Working Tree' && div -

  if git show-ref --verify --quiet "refs/heads/${TARGET_BRANCH}"; then # Check the existence of a branch (locally) 🦔
    [[ "$FORCE" = true ]] && { # ⚠️ ATTENTION ⚠️
      echo "☝️  #FORCE_MODE: We need to create a new branch \`${TARGET_BRANCH}\`..."
      git worktree add -B "$TARGET_BRANCH" "$TMP_WT_DIR" HEAD # 🪓 ♻️ 🌱
    } || {
      echo "We need to use the current local branch \`refs/heads/${TARGET_BRANCH}\`"
      git worktree add "$TMP_WT_DIR" "$TARGET_BRANCH" # 🌿
    }
  # elif git show-ref --verify --quiet "refs/remotes/origin/${TARGET_BRANCH}"; then # Check the existence of a branch (remote)
  #   echo "We need to use the current remote branch \`refs/remotes/origin/${TARGET_BRANCH}\` as source for a new branch..."
  #   git worktree add -b "$TARGET_BRANCH" "$TMP_WT_DIR" "origin/${TARGET_BRANCH}" && wtadded=true
  else
    [[ "$FORCE" = true ]] && { # ⚠️ ATTENTION ⚠️
      echo "☝️  #FORCE_MODE: We need to create a new branch \`${TARGET_BRANCH}\`..."
      git worktree add -B "$TARGET_BRANCH" "$TMP_WT_DIR" HEAD # 🪓 ♻️ 🌱
    } || { # D O E S N ’ T  E ❌ I S T
      echo "We need to create a new branch \`${TARGET_BRANCH}\`..."
      git worktree add -b "$TARGET_BRANCH" "$TMP_WT_DIR" HEAD # 🌱
    }
  fi

  wtadded=true && div - && echo '=> OK'

  # [[ "$target_branch_exists" = true ]] && {
  #   git worktree add "$TMP_WT_DIR" "$TARGET_BRANCH" && wtadded=true
  # } || {    
  #   git worktree add -b "$TARGET_BRANCH" "$TMP_WT_DIR" "$CURRENT_BRANCH" && wtadded=true # Create a worktree for the target branch if it doesn’t exist yet # WTF is going on here:
  #   #   - Git создаёт каталог `"$TMP_WT_DIR"` для новой рабочей директории.
  #   #   - Если ветка `$TARGET_BRANCH` существует: в worktree делается checkout последнего коммита этой ветки.
  #   #   - Если ветка `$TARGET_BRANCH` НЕ существует: создаётся новая ветка `$TARGET_BRANCH` от текущего commit (`HEAD` текущей ветки), и worktree привязывается к ней.
  #   #   - ❌ НЕ копируются незакоммиченные изменения текущей рабочей директории.
  #   #   - ❌ НЕ происходит merge с текущей веткой.
  #   #   - ❌ НЕ создаётся “полная копия репозитория”; общий `.git` используется для объектов и `refs`.
  #   #   - Каждый worktree имеет свой `HEAD` и отдельный `index` (staging area), расположенные в `.git/worktrees/<имя>`.
  #   #   - Текущая ветка в основной рабочей директории остаётся нетронутой.
  #   #   - Ветка `$TARGET_BRANCH` теперь “закреплена” за этой worktree, и Git не позволит одновременно сделать checkout этой ветки в другой рабочей директории.
  #   # Summary: Worktree — это отдельная рабочая директория + отдельный `HEAD` + отдельный index, привязанные к конкретной ветке, при общей истории и объектах. Это не “копия репозитория” и не “копия ветки”, а безопасный способ работать с другой веткой параллельно, без изменения текущей рабочей директории.
  # }

  # git switch -C "tmp-${TARGET_BRANCH}" || git checkout -B "tmp-${TARGET_BRANCH}" || abort "An error occurred while switching to or creating the \`tmp-${TARGET_BRANCH}\` branch." # 👈 BRANCH

}

div && echo '💣 Prepare for now!' && div -

pushd "$TMP_WT_DIR" &>/dev/null # 👈 SEEK

[[ "$mutatus" = false ]] && {

  echo '🙅‍ There are NO changes to the working directory. Check for unsent commits...'

  [[ "$DEBUG" = true ]] && git status

  current_branch="$(git rev-parse --abbrev-ref HEAD)"; [[ "$current_branch" = "$TARGET_BRANCH" ]] || abort 'Error: Current branch must be target branch.'

  if git rev-parse --verify "origin/${TARGET_BRANCH}" &>/dev/null; then # if [ -n "$(git log origin/$(git branch --show-current)..HEAD)" ]; then # Проверить наличие удалённой ветки
    if [[ -n "$(git rev-list "origin/${TARGET_BRANCH}..HEAD")" ]]; then
      echo '🙋‍ There are unsent commits.' # Есть неотправленные коммиты
    else
      echo '🙅‍ There are NO unsent commits.' # В данный момент НЕТ неотправленных коммитов
      exit 0 # 🔳 Q.E.D.
    fi
  else echo "🤷 Remote branch \`origin/${TARGET_BRANCH}\` doesn’t exist yet (first push needed)."; fi

  VERSION="${array[0]}.${array[1]}.${array[2]}" # major.minor.patch
  echo "📢 Current version ${VERSION}. Remains unchanged."

} || {

  echo '🙋‍ There are changes in the working directory.' # В рабочем каталоге произошли изменения

  [[ "$DEBUG" = true ]] && git status

  [[ "$DUMMY" = true ]] || {

    if git rev-parse --verify -q CHERRY_PICK_HEAD &>/dev/null; then
      echo '=> CHERRY_PICK_HEAD exists 🍒'
    else echo '=> no CHERRY_PICK_HEAD'; fi

    if git merge-base --is-ancestor "$current_commit_hash" HEAD; then

      echo 'ℹ️ Commit already reachable from target branch, skipping cherry-pick.'

    else

      echo '🍒 Cherry-picking changes from current branch...'
   
      git cherry-pick "$current_commit_hash" && git cherry-pick --continue || {
        if git rev-parse --verify -q CHERRY_PICK_HEAD &>/dev/null; then
          git cherry-pick --abort || : # Abort only when cherry-pick is actually in progress
        fi
        abort 'Error: Cherry-pick failed (conflicts or empty)'
      }

    fi

    [[ "$stashed" = true ]] && { # 🪵
      if git rev-parse --verify "$stash_reference" &>/dev/null; then # if git stash list | grep -q "$stash_reference"; then
        git stash pop "$stash_reference" &>/dev/null || abort 'Failed to pop stash.' # git stash apply "$stash_reference" &>/dev/null
        echo "✅ The stash \`${stash_reference}\` has been successfully restored."
      else echo "⚠️  The stash \`${stash_reference}\` not found!"; fi
    }

    if [[ "$TARGET_BRANCH" = main ]]; then
      VERSION="${array[0]}.$((array[1] + 1)).${array[2]}" # ℹ️ Incrementum (major.MINOR.patch)
    else
      VERSION="${array[0]}.${array[1]}.$((array[2] + 1))" # ℹ️ Incrementum (major.minor.PATCH)
    fi
    echo "$VERSION" > ./version
    echo "📢 The current version has been changed to $(cat ./version)."

    div -

    # git status

    git add -A || git add .

    # git diff --cached --quiet && abort "Nothing to commit"
    git commit -m "$VERSION" # 📌 Immutable Object

    div -

    # git switch "$CURRENT_BRANCH" # 👈 BRANCH
    # git reset --hard "$CURRENT_BRANCH_HEAD"

    # git switch "$TARGET_BRANCH" || abort 'Target branch doesn’t exist' # 👈 BRANCH

    git fsck --strict --full # ⛳️ Checkpoint
  }

}

[[ "$DEBUG" = true ]] && div && git status

[[ "$DUMMY" = true ]] || {
  new_head="$(git rev-parse HEAD)" && { # Capture the new head of the target branch from the worktree
    git -C "$SCRIPT_DIR" update-ref "refs/heads/${TARGET_BRANCH}" "$new_head" # Update local branch ref in the main workdir without checkout # Force local `${TARGET_BRANCH}` to `new_head`
  } || {
    git -C "$SCRIPT_DIR" branch -f "$TARGET_BRANCH" "$new_head" # Force-move local branch ref in the main workdir without checkout # Move `${TARGET_BRANCH}` to `new_head`
  }
}

popd &>/dev/null # 👈 SEEK

[[ "$DUMMY" = true ]] && error_code=0 || {
  [[ "$online" = true ]] && {
